{
  "name": "discord-autocompress",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local picture, GIF, and optional video compression and short video to GIF conversion for Discord in Zen, Firefox, and Chrome.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-check.mjs",
    "test:video": "node scripts/video-browser-check.mjs",
    "lint": "web-ext lint --source-dir dist --warnings-as-errors",
    "package": "npm run build && node scripts/package.mjs",
    "test:chrome": "node scripts/chrome-browser-check.mjs",
    "dev": "npm run build && web-ext run --source-dir dist --firefox zen-browser"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "geckodriver": "^8.0.0",
    "selenium-webdriver": "^4.51.0",
    "web-ext": "^10.8.0"
  }
}
